# -----------------------------------------------------------
# AuctionEngine Backend Environment Variables
# -----------------------------------------------------------

# Port for the Express server to run on
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/auction?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# JWT Secret for signing authentication tokens
# You can generate a random string for this
JWT_SECRET=your_super_secret_jwt_key_here

# Redis Connection String (Optional: If empty, uses In-Memory Mock Redis)
# Example: redis://default:<password>@redis-server.com:6379
REDIS_URL=your_redis_connection_string_here

# Frontend URL for CORS protection
# Example: http://localhost:5173 (for local dev) or https://your-vercel-app.com
CLIENT_URL=http://localhost:5173
