# -----------------------------------------------------------
# AuctionEngine Backend Environment Variables
# -----------------------------------------------------------

# Port for the Express server to run on
PORT=5000

# MongoDB Atlas Connection String (Cluster0 - AuctionEngine)
# Format: mongodb+srv://<username>:<password>@cluster0.<unique-id>.mongodb.net/AuctionEngine?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/AuctionEngine?retryWrites=true&w=majority

# JWT Secret for signing authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Redis Connection String (Optional: If empty, uses In-Memory Mock Redis)
REDIS_URL=

# Frontend URL for CORS protection
CLIENT_URL=http://localhost:5173
